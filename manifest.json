{
  "manifest_version": 3,
  "name": "Nakupna Brzda",
  "version": "0.1.0",
  "description": "MVP rozsirenie, ktore vlozi mentalnu barieru pred impulzivnym nakupom.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Nakupna Brzda"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "modal-template.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
